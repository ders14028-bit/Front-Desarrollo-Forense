# true = datos mock generados en el navegador; false = backend Spring Boot.
# Si no se define: mock en desarrollo (npm run dev) y backend real en producción (npm run build).
VITE_USE_MOCK=true
# Solo con el mock: si es true, toda llamada falla, para probar el estado de error.
VITE_MOCK_ERROR=false
# true = el mock de Wazuh simula la carga inicial del backend ("Cargando datos de Wazuh… 40 %")
VITE_MOCK_WAZUH_CARGANDO=false
# URL del backend (solo con VITE_USE_MOCK=false). Nunca pongas aquí la API key de TheHive.
VITE_API_URL=http://localhost:8080
# URL base de TheHive solo para los enlaces "Abrir en TheHive" del detalle de una alerta (http o https).
# Sin valor, esos enlaces no se muestran. No es un secreto, pero tampoco se versiona la de tu entorno.
VITE_THEHIVE_URL=
